# Optional. Copy to .env and uncomment what you want to change, then run: docker compose up -d
# Every value below shows its default.

# Port and address
# BUCKETDESK_PORT=8080
# APP_URL=http://localhost:8080
# Turn on with an https APP_URL.
# SESSION_SECURE_COOKIE=false

# Built-in inbox port (http://localhost:8025)
# MAILPIT_PORT=8025

# Your own mail server instead of the built-in inbox
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SCHEME=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=bucketdesk@example.com

# From the bucketdesk-access CloudFormation stack (README, Connect your bucket)
# AWS_CUSTOMER_ACCESS_PRINCIPAL_ARN=
# AWS_DEFAULT_REGION=us-east-1

# Database password. Set it before the first start; changing it later needs a database change too.
# DB_PASSWORD=bucketdesk

# Your own encryption key instead of the one made on first start (base64: then 32 random bytes).
# APP_KEY=

# Licence key for paid features (or paste it under Settings, Licence)
# SELF_HOSTED_LICENCE=

# Disk, in GB, kept for opening files when the internet is down. 0 turns it off.
# OFFLINE_CACHE_GB=10
